@page "/"

@inject IHttpClientFactory HttpClientFactory

<PageTitle>SudokuS</PageTitle>

<h1>Sudoku</h1>

<p>Partida actual: @idSesion</p>

@if (tablero != null)
{
    <div tabindex="0" @onkeydown="PresionarTecla" @onfocusout="DeseleccionarCelda" style="outline:none;">
        <table>
            @for (int fil = 0; fil < 9; fil++)
            {
                <tr>
                    @for(int col = 0; col < 9; col++)
                    {
                        bool esCeldaSelec = fil == filSelec && col == colSelec;
                        bool esErronea = errores.ContainsKey((fil, col));

                        <td class="@(esCeldaSelec ? "celdaSelec" : "") @(esErronea ? "celdaError" : "")"
                            @onclick="() => SeleccionarCelda(fil,col)">
                            @(tablero[fil, col] == 0 ? "" : tablero[fil, col].ToString())
                        </td>
                    }
                </tr>
            }
        </table>
    </div>
}
else
{
    <p>Error al cargar el tablero</p>
}

<select @onchange="OnDificultadChanged">
    <option value="1" selected>Fácil</option>
    <option value="2">Media</option>
    <option value="3">Difícil</option>
</select>
<button type="button" id="btnNueva" @onclick="NuevaPartida">Nueva partida</button>
<button type="button" id="btnCargar">Cargar partida</button>
<button type="button" id="btnGuardar">Guardar partida</button>

@code {
    private HttpClient Http => HttpClientFactory.CreateClient("SudokuApi");

    private String? idSesion;
    private byte[,]? tablero;
    private byte[,]? tableroInicial;
    Dictionary<(int fila, int col), HashSet<(int fila, int col)>> errores = new(); // Para cada celda en conflicto, guarda las posiciones que causan conflicto
    private int dificultad;
    private int filSelec = -1;
    private int colSelec = -1;



    protected override async Task OnInitializedAsync()
    {
        dificultad = 1;
        await NuevaPartida();
    }

    private void PresionarTecla(KeyboardEventArgs e)
    {
        if (filSelec == -1) return;
        if (e.Key.Length == 1 && char.IsDigit(e.Key[0]))
        {
            byte valor = byte.Parse(e.Key);
            if (valor == tablero![filSelec, colSelec]) return; // Si el mismo valor, nada

            if (valor >= 1 && valor <= 9)
            {
                tablero![filSelec, colSelec] = valor;
            }
            else if (valor == 0)
            {
                tablero![filSelec, colSelec] = 0; // Borrar el valor
            }
            ComprobarErrores(filSelec, colSelec);
        }
        else if (e.Key == "Backspace" || e.Key == "Delete")
        {
            if (tablero![filSelec, colSelec] == 0) return;
            tablero![filSelec, colSelec] = 0; // Borrar el valor
            ComprobarErrores(filSelec, colSelec);
        }
        else if (e.Key == "ArrowUp")
        {
            do
            {
                filSelec = (filSelec + 8) % 9; // Mover hacia arriba
            } while (tableroInicial![filSelec, colSelec] != 0); //No seleccionar iniciales
        }
        else if (e.Key == "ArrowDown")
        {
            do
            {
                filSelec = (filSelec + 1) % 9; // Mover hacia abajo
            } while (tableroInicial![filSelec, colSelec] != 0); //No seleccionar iniciales
        }
        else if (e.Key == "ArrowLeft")
        {
            do
            {
                colSelec = (colSelec + 8) % 9; // Mover hacia la izquierda
            } while (tableroInicial![filSelec, colSelec] != 0); //No seleccionar iniciales
        }
        else if (e.Key == "ArrowRight")
        {
            do
            {
                colSelec = (colSelec + 1) % 9; // Mover hacia la derecha
            } while (tableroInicial![filSelec, colSelec] != 0); //No seleccionar iniciales
        }
    }

    private void ComprobarErrores(int fil, int col)
    {
        byte valor = tablero![fil, col];
        var celda = (fil, col);

        if (errores.TryGetValue((celda), out var conflictos)) //El número ha cambiado, elimino conflictos previos
        {
            foreach (var coord in conflictos)
            {
                if (errores.TryGetValue(coord, out var set))
                {
                    set.Remove((celda));
                    if (set.Count == 0)
                        errores.Remove(coord);
                }
            }

            if (valor == 0)
            {
                errores.Remove(celda);
                return;
            }

            errores[celda].Clear();
        } 
        else
        {
            if (valor == 0) return;
            errores.Add(celda, new HashSet<(int, int)>());
        }

        //Comprobar fila
        for (int c = 0; c < 9; c++)
        {
            if (tablero[fil, c] == valor && c != col)
            {
                errores[celda].Add((fil, c));
                if (tableroInicial![fil, c] == 0)
                {
                    errores.Add((fil, c), new HashSet<(int, int)>());
                    errores[(fil, c)].Add(celda);
                }
            }
        }

        //Comprobar columna
        for (int f = 0; f < 9; f++)
        {
            if (tablero[f, col] == valor && f != fil)
            {
                errores[celda].Add((f, col));
                if (tableroInicial![f, col] == 0)
                {
                    errores.Add((f, col), new HashSet<(int, int)>());
                    errores[(f, col)].Add(celda);
                }
            }
        }

        //Comprobar bloque
        int filInicioBloque = fil - fil % 3;
        int colInicioBlque = col - col % 3;

        for (int i = 0; i < 3; i++)
            for (int j = 0; j < 3; j++)
                if (tablero[filInicioBloque + i, colInicioBlque + j] == valor && (filInicioBloque + i != fil || colInicioBlque + j != col))
                {
                    errores[celda].Add((filInicioBloque + i, colInicioBlque + j));
                    if (tableroInicial![filInicioBloque + i, colInicioBlque + j] == 0)
                    {
                        errores.Add((filInicioBloque + i, colInicioBlque + j), new HashSet<(int, int)>());
                        errores[(filInicioBloque + i, colInicioBlque + j)].Add(celda);
                    }
                }

        if (errores[celda].Count == 0)
            errores.Remove(celda);
    }

    private void SeleccionarCelda(int fil, int col)
    {
        if (tableroInicial![fil, col] != 0)
        {
            DeseleccionarCelda();
            return; //No se puede seleccionar una celda inicial
        }
        filSelec = fil;
        colSelec = col;
    }

    private void DeseleccionarCelda()
    {
        filSelec = -1;
        colSelec = -1;
    }

    private void OnDificultadChanged(ChangeEventArgs e)
    {
        dificultad = int.Parse(e.Value!.ToString()!);
    }

    private async Task NuevaPartida()
    {
        var responseMessage = await Http.PostAsync(
            $"/nuevo/{dificultad}",
            new StringContent("", System.Text.Encoding.UTF8, "application/json")
        );

        if (!responseMessage.IsSuccessStatusCode)
        {
            var errorContent = await responseMessage.Content.ReadAsStringAsync();
            Console.WriteLine($"Error en la API: {errorContent}");
            return;
        }

        // Leer la respuesta como string
        var jsonString = await responseMessage.Content.ReadAsStringAsync();

        // Deserializar usando Newtonsoft.Json
        var response = JsonConvert.DeserializeObject<DTOs.NuevaPartidaResponse>(jsonString);

        if (response == null) return; // Quizás redireccionar a una página de error

        idSesion = response.IdSesion;
        tableroInicial = response.Tablero;
        ClonarTablero(); //Ref 1
        StateHasChanged();
    }

    private void ClonarTablero()
    {
        if (tableroInicial == null) return;
        tablero = new byte[9, 9];
        for (int fil = 0; fil < 9; fil++)
        {
            for (int col = 0; col < 9; col++)
            {
                tablero[fil, col] = tableroInicial[fil, col];
            }
        }
    }

    /* -Ref 1: En un principio había creado las celdas como clases, pensé que era innecesario y pasé a trabajar directa y unicamente con
        matrices, pero claro, desconocía como funcionaba Blazor... Creo que lo más óptimo sería tener la clase Celda, en este caso
        solo para decir si esInicial o no, ahorraba la matriz tableroInicial y la función de ClonarTablero. Lección que me llevo.
        */
}
